          "authorImage": "https://yt3.ggpht.com/hLPoAF5zZZMQ9PXWQtYvwFGwWMDx_fejp19tYVFUKT1xlWav-EyiS-jnLeqOPjzu-kB8GhFbnQ=s48-c-k-c0x00ffffff-no-rj",
          "text": "飛行機じゃない",
          "likeCount": 2,

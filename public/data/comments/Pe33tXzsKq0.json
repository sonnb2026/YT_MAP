      "author": "@TaikiTaikiDesu",
      "authorImage": "https://yt3.ggpht.com/YsbftJps_eBREE99kHU_g0HRS7YYhsfHy0037SGTw_WqlXQRq0Hc64dcSzXBm8hhO0PQmPPy7UA=s48-c-k-c0x00ffffff-no-rj",
      "text": "水道代たかそー",
      "likeCount": 4,
